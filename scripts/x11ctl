# ---------------------------------------------------------------------------
# Command implementations
# ---------------------------------------------------------------------------

# Maps tier names to their start function NAMES (resolved via globals()
# at call time to respect mocking in tests).
_TIER_START_FN_NAMES: dict[str, str] = {
    "headless": "start_headless",
    "xpra": "start_xpra",
    "vnc": "start_vnc",
}

# For structural invariant tests — expose keys like _TIER_START_FN would
_TIER_START_FN = _TIER_START_FN_NAMES

# Maps component names to their expected process comm names for stop
_COMPONENT_COMM: dict[str, str] = {
    "xvfb": "Xvfb",
    "xpra": "xpra",
    "x11vnc": "x11vnc",
    "websockify": "websockify",
}


def start_command_impl(
    cfg: Config, desired: set[str], bind_all: bool
) -> int:
    """Declarative start: reconcile current tiers to desired state.

    Acquires exclusive lock, reads current tiers, computes diff, stops
    excess tiers, starts missing tiers. Rolls back on failure.
    """
    lock_fd = acquire_lock(cfg.lock_file, exclusive=True)
    if lock_fd is None:
        print("Error: another x11ctl operation is in progress", file=sys.stderr)
        return 1
    try:
        current = read_tiers(cfg.tiers_file) or set()
        to_stop, to_start = compute_tier_diff(current, desired)

        # Stop excess components (in STOP_ORDER)
        for comp in STOP_ORDER:
            for tier in to_stop:
                if comp in tier_components(tier):
                    stop_component(cfg.pidfile(comp), _COMPONENT_COMM.get(comp, comp))

        # Start missing tiers (headless first — dependency order)
        bind = "0.0.0.0" if bind_all else cfg.bind
        started: list[str] = []
        start_order = ["headless", "xpra", "vnc"]  # dependency order

        for tier in start_order:
            if tier in to_start:
                fn_name = _TIER_START_FN_NAMES.get(tier)
                fn = globals().get(fn_name) if fn_name else None
                if fn is None:
                    continue
                rc = fn(cfg, started, bind=bind)
                if rc != 0:
                    # Rollback: stop everything we started in this invocation.
                    # Contract: start_* functions append component names (not tier
                    # names) matching _COMPONENT_COMM keys and cfg.pidfile keys.
                    for rollback_comp in reversed(started):
                        if rollback_comp not in _COMPONENT_COMM:
                            print(
                                f"Warning: unknown component in rollback: {rollback_comp}",
                                file=sys.stderr,
                            )
                            continue
                        stop_component(
                            cfg.pidfile(rollback_comp),
                            _COMPONENT_COMM[rollback_comp],
                        )
                    # Clean up tiers file if nothing was running before
                    if not current:
                        delete_tiers(cfg.tiers_file)
                    # Clean up xauth if headless was started (and wasn't
                    # previously running) — matches start_headless internal
                    # rollback which also cleans xauth on failure.
                    if "xvfb" in started and "headless" not in current:
                        try:
                            os.unlink(cfg.xauth)
                        except FileNotFoundError:
                            pass
                    return rc

        # Write new tiers state
        write_tiers(cfg.tiers_file, desired)
        return 0
    finally:
        release_lock(lock_fd)


def stop_command_impl(cfg: Config, tier: str) -> int:
    """Subtractive stop: remove specified tiers from running state.

    Acquires exclusive lock, reads current tiers, computes cascade,
    stops components. Only cleans xauth when headless is stopped.
    """
    lock_fd = acquire_lock(cfg.lock_file, exclusive=True)
    if lock_fd is None:
        print("Error: another x11ctl operation is in progress", file=sys.stderr)
        return 1
    try:
        current = read_tiers(cfg.tiers_file) or set()
        if not current:
            return 0  # nothing to stop

        to_stop = compute_cascade_stop(tier, current)
        if not to_stop:
            return 0

        # Stop components in STOP_ORDER, track per-component success
        all_ok = True
        stopped_components: set[str] = set()
        for comp in STOP_ORDER:
            for t in to_stop:
                if comp in tier_components(t):
                    ok = stop_component(
                        cfg.pidfile(comp), _COMPONENT_COMM.get(comp, comp)
                    )
                    if ok:
                        stopped_components.add(comp)
                    else:
                        all_ok = False

        # A tier is fully stopped only when ALL its components stopped
        stopped_tiers: set[str] = set()
        for t in to_stop:
            comps = tier_components(t)
            if all(c in stopped_components for c in comps):
                stopped_tiers.add(t)

        remaining = current - stopped_tiers

        if all_ok and not remaining:
            # Everything stopped — delete tiers file and clean xauth
            delete_tiers(cfg.tiers_file)
            if "headless" in stopped_tiers:
                try:
                    os.unlink(cfg.xauth)
                except FileNotFoundError:
                    pass
            return 0

        if remaining:
            # Some tiers still running — update tiers file
            write_tiers(cfg.tiers_file, remaining)
        else:
            # All tiers stopped but some components failed — preserve
            # surviving tiers (the ones whose stop returned False)
            failed_tiers = to_stop - stopped_tiers
            if failed_tiers:
                write_tiers(cfg.tiers_file, failed_tiers)

        if all_ok and "headless" in stopped_tiers:
            try:
                os.unlink(cfg.xauth)
            except FileNotFoundError:
                pass

        return 0 if all_ok else 1
    finally:
        release_lock(lock_fd)


def status_command_impl(cfg: Config) -> int:
    """Report running status of all expected components. Returns 0 if healthy, 1 if degraded."""
    lock_fd = acquire_lock(cfg.lock_file, exclusive=False)
    if lock_fd is None:
        print("Error: another x11ctl operation is in progress", file=sys.stderr)
        return 1
    try:
        current = read_tiers(cfg.tiers_file)
        if current is None:
            print("x11ctl: no active tiers", file=sys.stderr)
            return 0

        healthy = True
        for tier in sorted(current):
            for comp in tier_components(tier):
                data = read_pidfile(cfg.pidfile(comp))
                if data is None:
                    print(f"  {comp}: DOWN (no pidfile)", file=sys.stderr)
                    healthy = False
                    continue
                pid, epoch = data
                if validate_pid(pid, epoch, _COMPONENT_COMM.get(comp, comp)):
                    print(f"  {comp}: UP (PID {pid})", file=sys.stderr)
                else:
                    print(f"  {comp}: DOWN (stale PID {pid})", file=sys.stderr)
                    healthy = False

        return 0 if healthy else 1
    finally:
        release_lock(lock_fd)


# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------

def _determine_desired_tiers(args: argparse.Namespace) -> set[str]:
    """Determine desired tiers from CLI flags. Defaults to headless if none set."""
    if getattr(args, "all", False):
        return desired_tiers("all")
    if getattr(args, "xpra", False) and getattr(args, "vnc", False):
        return desired_tiers("all")
    if getattr(args, "xpra", False):
        return desired_tiers("xpra")
    if getattr(args, "vnc", False):
        return desired_tiers("vnc")
    if getattr(args, "headless", False):
        return desired_tiers("headless")
    return desired_tiers("headless")  # default


def _determine_stop_tier(args: argparse.Namespace) -> str:
    """Determine which tier to stop. Defaults to 'all' if none set.

    Multiple flags (--xpra --vnc) or headless all cascade to 'all'.
    """
    flags = []
    if getattr(args, "headless", False):
        flags.append("headless")
    if getattr(args, "xpra", False):
        flags.append("xpra")
    if getattr(args, "vnc", False):
        flags.append("vnc")
    if getattr(args, "all", False) or not flags:
        return "all"
    if len(flags) > 1 or "headless" in flags:
        return "headless"  # headless cascades everything; multiple flags = stop all
    return flags[0]


def main() -> None:
    """Entry point."""
    args = parse_args(sys.argv[1:])
    if args.command is None:
        parse_args(["--help"])
        return

    cfg = Config()

    if args.command == "start":
        desired = _determine_desired_tiers(args)
        bind_all = getattr(args, "bind_all", False)
        sys.exit(start_command_impl(cfg, desired, bind_all))
    elif args.command == "stop":
        tier = _determine_stop_tier(args)
        sys.exit(stop_command_impl(cfg, tier))
    elif args.command == "status":
        sys.exit(status_command_impl(cfg))
    elif args.command == "env":
        print(format_env(cfg), end="")
    else:
        print(f"x11ctl: command '{args.command}' not yet implemented", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
