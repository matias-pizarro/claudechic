#!/usr/local/bin/python3
"""x11ctl — Manage X11 inside FreeBSD jails.

Single-file script (stdlib only, Python >=3.10) managing a 3-tier X11 stack:
  Tier 1 (Headless): Xvfb virtual framebuffer
  Tier 2 (Xpra):     Remote viewing via Xpra shadow + HTML5
  Tier 3 (VNC):      x11vnc + noVNC/websockify fallback
"""
from __future__ import annotations

import argparse
import fcntl
import os
import re
import shlex
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable, Literal, Optional


# ---------------------------------------------------------------------------
# Safe file I/O helpers
# ---------------------------------------------------------------------------

def _safe_open_regular(path: str, flags: int, mode: int = 0) -> int:
    """Open a file with O_NOFOLLOW | O_NONBLOCK, then verify it is a regular file.

    Prevents FIFO-based DoS (O_NONBLOCK prevents blocking on FIFO open)
    and symlink attacks (O_NOFOLLOW). After open, fstat verifies the fd
    points to a regular file before any I/O.

    Raises OSError if the path is not a regular file (symlink, FIFO, etc.).
    """
    fd = os.open(path, flags | os.O_NOFOLLOW | os.O_NONBLOCK, mode)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            os.close(fd)
            raise OSError(f"Not a regular file: {path} (mode={oct(st.st_mode)})")
        # Clear O_NONBLOCK for subsequent I/O (read/write should block normally)
        fcntl.fcntl(fd, fcntl.F_SETFL, fcntl.fcntl(fd, fcntl.F_GETFL) & ~os.O_NONBLOCK)
        return fd
    except BaseException:
        os.close(fd)
        raise


# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

def _parse_port_env(name: str, default: int) -> int:
    """Parse a port number from an env var with a user-friendly error.

    Distinguishes unset (returns default) from empty string (errors).
    """
    raw = os.environ.get(name)
    if raw is None:
        return default
    try:
        return int(raw)
    except ValueError:
        raise ValueError(f"{name} must be an integer (got {raw!r})")


_DISPLAY_RE = re.compile(r"^:\d+\Z")
_SCREEN_RE = re.compile(r"^\d+x\d+x\d+\Z")
_XAUTH_RE = re.compile(r"^/tmp/\.x11ctl-[A-Za-z0-9._-]+\Z")



@dataclass(frozen=True)
class Config:
    """Immutable configuration built from env vars and defaults."""

    display: str = field(default_factory=lambda: os.environ.get("X11CTL_DISPLAY", ":99"))
    screen: str = field(default_factory=lambda: os.environ.get("X11CTL_SCREEN", "1920x1080x24"))
    bind: str = field(default_factory=lambda: os.environ.get("X11CTL_BIND", "127.0.0.1"))
    xpra_port: int = field(default_factory=lambda: _parse_port_env("X11CTL_XPRA_PORT", 10000))
    vnc_port: int = field(default_factory=lambda: _parse_port_env("X11CTL_VNC_PORT", 5900))
    novnc_port: int = field(default_factory=lambda: _parse_port_env("X11CTL_NOVNC_PORT", 6080))
    xauth: str = field(default_factory=lambda: os.environ.get("X11CTL_XAUTH", ""))
    state_prefix: str = field(default=".x11ctl")
    state_dir: str = field(default="")

    def __post_init__(self) -> None:
        # Validate display
        if not _DISPLAY_RE.match(self.display):
            raise ValueError(f"X11CTL_DISPLAY must match :<digits> (got {self.display!r})")
        # Validate screen
        if not _SCREEN_RE.match(self.screen):
            raise ValueError(f"X11CTL_SCREEN must match <W>x<H>x<D> (got {self.screen!r})")
        # Validate ports
        for port_name in ("xpra_port", "vnc_port", "novnc_port"):
            val = getattr(self, port_name)
            if not (1 <= val <= 65535):
                raise ValueError(f"{port_name} must be 1-65535 (got {val})")
        # Validate and normalize bind address — round-trip rejects non-canonical
        # forms (hex, octal, abbreviated) that external tools may not handle
        try:
            canonical = socket.inet_ntoa(socket.inet_aton(self.bind))
        except OSError:
            raise ValueError(f"bind must be a valid IPv4 address (got {self.bind!r})")
        if canonical != self.bind:
            raise ValueError(
                f"bind must be canonical dotted-quad (got {self.bind!r}, "
                f"canonical form is {canonical!r})"
            )
        # Resolve xauth: use self.xauth (from env or constructor), fallback to default
        raw_xauth = self.xauth
        if raw_xauth:
            normalized = str(Path(raw_xauth).resolve(strict=False))
            if normalized != raw_xauth:
                object.__setattr__(self, "xauth", normalized)
        else:
            object.__setattr__(self, "xauth", "/tmp/.x11ctl-xauth")
        # Always validate the final xauth value — catches constructor-supplied
        # paths (e.g. Config(xauth="/etc/shadow")) and env-supplied paths alike.
        if not _XAUTH_RE.match(self.xauth):
            raise ValueError(
                f"xauth must resolve to /tmp/.x11ctl-<safe-name> "
                f"(got {raw_xauth!r} -> {self.xauth!r})"
            )

    @property
    def display_number(self) -> int:
        return int(self.display[1:])

    def pidfile(self, component: str) -> str:
        if self.state_dir:
            return os.path.join(self.state_dir, f"{self.state_prefix}-{component}.pid")
        return f"/tmp/{self.state_prefix}-{component}.pid"

    def logfile(self, component: str) -> str:
        if self.state_dir:
            return os.path.join(self.state_dir, f"{self.state_prefix}-{component}.log")
        return f"/tmp/{self.state_prefix}-{component}.log"

    @property
    def tiers_file(self) -> str:
        if self.state_dir:
            return os.path.join(self.state_dir, f"{self.state_prefix}-tiers")
        return f"/tmp/{self.state_prefix}-tiers"

    @property
    def lock_file(self) -> str:
        if self.state_dir:
            return os.path.join(self.state_dir, f"{self.state_prefix}.lock")
        return f"/tmp/{self.state_prefix}.lock"

    @classmethod
    def for_self_test(cls, display_num: int, state_dir: str) -> Config:
        """Factory for self-test configs. Pure path derivation, no side effects.

        Explicitly sets ALL env-backed fields to known-good values so
        self-test behavior is deterministic regardless of environment.
        """
        return cls(
            display=f":{display_num}",
            screen="1920x1080x24",
            bind="127.0.0.1",
            xpra_port=10000 + display_num,
            vnc_port=5900 + display_num,
            novnc_port=6080 + display_num,
            xauth=f"/tmp/.x11ctl-selftest-{display_num}",
            state_prefix=f".x11ctl-selftest-{display_num}",
            state_dir=state_dir,
        )


# ---------------------------------------------------------------------------
# Tier logic
# ---------------------------------------------------------------------------

_TIER_DEPS: dict[str, frozenset[str]] = {
    "headless": frozenset({"headless"}),
    "xpra": frozenset({"headless", "xpra"}),
    "vnc": frozenset({"headless", "vnc"}),
    "all": frozenset({"headless", "xpra", "vnc"}),
}


# Meta-tiers are aliases/aggregates that expand to component tiers.
# Any new meta-tier must be listed here; all other _TIER_DEPS keys are components.
_META_TIERS = frozenset({"all"})

# Component-level tiers: derived from _TIER_DEPS minus known meta-tiers.
# If a new tier is added to _TIER_DEPS it becomes a component unless listed
# in _META_TIERS — this is the intended behavior.
_COMPONENT_TIERS = frozenset(_TIER_DEPS.keys()) - _META_TIERS


def desired_tiers(tier: str) -> set[str]:
    """Return the set of tiers implied by a tier name.

    Raises ValueError for unknown tier names.
    """
    if tier not in _TIER_DEPS:
        raise ValueError(f"Unknown tier: {tier!r} (valid: {', '.join(sorted(_TIER_DEPS))})")
    return set(_TIER_DEPS[tier])


# ---------------------------------------------------------------------------
# CLI parsing
# ---------------------------------------------------------------------------

def parse_args(argv: list[str]) -> argparse.Namespace:
    """Parse command-line arguments."""
    parser = argparse.ArgumentParser(
        prog="x11ctl",
        description="Manage X11 inside FreeBSD jails",
    )
    sub = parser.add_subparsers(dest="command")

    # start
    p_start = sub.add_parser("start", help="Start X11 components")
    p_start.add_argument("--headless", action="store_true")
    p_start.add_argument("--xpra", action="store_true")
    p_start.add_argument("--vnc", action="store_true")
    p_start.add_argument("--all", action="store_true")
    p_start.add_argument("--bind-all", action="store_true")

    # stop
    p_stop = sub.add_parser("stop", help="Stop X11 components")
    p_stop.add_argument("--headless", action="store_true")
    p_stop.add_argument("--xpra", action="store_true")
    p_stop.add_argument("--vnc", action="store_true")
    p_stop.add_argument("--all", action="store_true")

    # status
    sub.add_parser("status", help="Show running state")

    # env
    sub.add_parser("env", help="Print DISPLAY/XAUTHORITY exports")

    # run
    p_run = sub.add_parser("run", help="Run command with temporary Xvfb")
    p_run.add_argument("run_command", nargs=argparse.REMAINDER)

    # screenshot
    p_ss = sub.add_parser("screenshot", help="Capture display to PNG")
    p_ss.add_argument("path", help="Output PNG path")

    # setup
    p_setup = sub.add_parser("setup", help="Install packages")
    p_setup.add_argument("--tier1", action="store_true")
    p_setup.add_argument("--tier2", action="store_true")
    p_setup.add_argument("--tier3", action="store_true")
    p_setup.add_argument("--all", action="store_true")

    # self-test
    p_selftest = sub.add_parser("self-test", help="Run self-test")
    p_selftest.add_argument("--tier1", action="store_true")
    p_selftest.add_argument("--tier2", action="store_true")
    p_selftest.add_argument("--tier3", action="store_true")
    p_selftest.add_argument("--all", action="store_true")

    return parser.parse_args(argv)


# ---------------------------------------------------------------------------
# Pidfile I/O
# ---------------------------------------------------------------------------

def write_pidfile(path: str, pid: int, epoch: int) -> None:
    """Atomically write a pidfile. Rejects symlinks."""
    # Check target is not a symlink
    if os.path.lexists(path) and os.path.islink(path):
        raise OSError(f"Refusing to write pidfile over symlink: {path}")

    # Write to temp file in same directory, then atomic rename
    dir_path = os.path.dirname(path) or "."
    fd = tempfile.mkstemp(dir=dir_path, prefix=".pidfile-")
    try:
        os.write(fd[0], f"{pid} {epoch}\n".encode())
        os.close(fd[0])
        # Final symlink check before rename
        if os.path.lexists(path) and os.path.islink(path):
            os.unlink(fd[1])
            raise OSError(f"Refusing to write pidfile over symlink: {path}")
        os.rename(fd[1], path)
    except BaseException:
        try:
            os.unlink(fd[1])
        except FileNotFoundError:
            pass
        raise


def read_pidfile(path: str) -> Optional[tuple[int, int]]:
    """Read a pidfile. Returns (pid, epoch) or None.

    Rejects symlinks (O_NOFOLLOW) and non-regular files like FIFOs
    (fstat check via _safe_open_regular) to prevent DoS.
    """
    if os.path.islink(path):
        return None
    try:
        fd = _safe_open_regular(path, os.O_RDONLY)
        try:
            data = os.read(fd, 256).decode().strip()
        finally:
            os.close(fd)
        parts = data.split()
        if len(parts) != 2:
            return None
        pid, epoch = int(parts[0]), int(parts[1])
        if pid < 1 or epoch < 0:
            return None  # Reject tampered pidfiles (negative PID would kill all)
        return pid, epoch
    except (FileNotFoundError, ValueError, OSError):
        return None


# ---------------------------------------------------------------------------
# PID identity validation
# ---------------------------------------------------------------------------

def validate_pid(pid: int, created_epoch: int, expected_comm: str) -> bool:
    """Validate that a PID is alive, has the expected process name, and age matches.

    Uses 3-factor check:
    1. os.kill(pid, 0) — is the process alive?
    2. ps -p <pid> -o comm= — does the process name match?
    3. ps -p <pid> -o etimes= vs time.time() - created_epoch — age match within ±5s?

    Falls back to 2-factor (alive + comm) if etimes is unavailable.
    """
    # Check 1: alive
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        # Process exists but belongs to another user. Treat as invalid
        # (stale pidfile — the managed process is gone and PID was reused).
        # This is consistent with stop_component's behavior: clean up the
        # pidfile but do not attempt to signal a process we don't own.
        # Note: validate_pid_tristate returns "unknown" for PermissionError
        # because stale recovery needs fail-closed semantics (don't clean
        # up what you can't verify). The different return values reflect
        # different caller requirements, not a logic inconsistency.
        return False

    # Check 2: process name
    try:
        result = subprocess.run(
            ["/bin/ps", "-p", str(pid), "-o", "comm="],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode != 0:
            return False  # ps failed — process likely dead
        actual_comm = result.stdout.strip()
        if not actual_comm or actual_comm != expected_comm:
            return False
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return False

    # Check 3: age match (best-effort — enhances confidence but not required)
    # If etimes is unavailable (restricted jail, ps timeout), we already have
    # 2-factor validation (PID alive + comm match) which passed above.
    # The 3rd factor only REJECTS — it never grants access on its own.
    try:
        result = subprocess.run(
            ["/bin/ps", "-p", str(pid), "-o", "etimes="],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode != 0:
            pass  # ps failed for etimes — fall through to 2-factor
        elif etimes_str := result.stdout.strip():
            etimes = int(etimes_str)
            expected_age = int(time.time()) - created_epoch
            if abs(etimes - expected_age) > 5:
                return False  # Age mismatch — PID was reused
        # If etimes_str is empty or ps failed, skip age check (2-factor only)
    except (subprocess.TimeoutExpired, FileNotFoundError, ValueError):
        pass  # etimes unavailable — proceed with 2-factor result

    # Passed 2-factor (alive + comm) and optionally 3-factor (+ age)
    return True


def validate_pid_tristate(
    pid: int, created_epoch: int, expected_comm: str
) -> Literal["alive", "dead", "unknown"]:
    """Like validate_pid but returns 'alive' / 'dead' / 'unknown'.

    'unknown' is returned when the PID cannot be conclusively validated
    (e.g., ps timeout, missing ps binary, PermissionError on kill probe).
    Used by stale recovery where 'unknown' means fail-closed (skip cleanup).
    """
    # Check 1: alive
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return "dead"
    except PermissionError:
        return "unknown"  # Process exists but can't probe — fail closed

    # Check 2: process name
    try:
        result = subprocess.run(
            ["/bin/ps", "-p", str(pid), "-o", "comm="],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode != 0:
            return "dead"  # ps failed — process likely dead
        actual_comm = result.stdout.strip()
        if not actual_comm or actual_comm != expected_comm:
            return "dead"
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return "unknown"

    # Check 3: age match
    try:
        result = subprocess.run(
            ["/bin/ps", "-p", str(pid), "-o", "etimes="],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode != 0:
            pass  # ps failed for etimes — fall through to 2-factor
        elif etimes_str := result.stdout.strip():
            etimes = int(etimes_str)
            expected_age = int(time.time()) - created_epoch
            if abs(etimes - expected_age) > 5:
                return "dead"  # Age mismatch — PID was reused
        # If etimes_str is empty or ps failed, skip age check (2-factor only)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return "unknown"
    except ValueError:
        return "unknown"  # Malformed etimes — fail closed

    return "alive"


# ---------------------------------------------------------------------------
# Process lifecycle — stop
# ---------------------------------------------------------------------------

def stop_component(pidfile_path: str, expected_comm: str) -> bool:
    """Stop a component by reading its pidfile, validating identity, and killing.

    Returns True on success (or nothing to do).
    Returns False only when SIGKILL also fails (process truly unstoppable).
    Partial-stop failure does not block stopping other components — the caller
    should continue stopping remaining components and report failure in exit code.

    Uses validate_pid_tristate for fail-closed behavior: "unknown" PID state
    is preserved (pidfile not cleaned up) rather than aggressively deleted.
    """
    data = read_pidfile(pidfile_path)
    if data is None:
        return True  # no pidfile = nothing to stop

    pid, created_epoch = data

    # Validate identity before killing — use tristate for fail-closed.
    # "dead" → stale pidfile, clean up. "unknown" → can't verify, preserve.
    # "alive" → proceed to kill.
    state = validate_pid_tristate(pid, created_epoch, expected_comm)
    if state == "dead":
        # Confirmed stale — safe to clean up
        try:
            os.unlink(pidfile_path)
        except FileNotFoundError:
            pass
        return True
    if state == "unknown":
        # Can't determine if process is ours — fail closed, don't touch.
        print(
            f"Warning: cannot verify PID {pid} ({expected_comm}) — "
            f"pidfile preserved: {pidfile_path}",
            file=sys.stderr,
        )
        return True

    # state == "alive" — proceed to kill

    # Kill: SIGTERM → wait → SIGKILL
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        # Died between validate and kill
        try:
            os.unlink(pidfile_path)
        except FileNotFoundError:
            pass
        return True
    except PermissionError:
        # PID reused by another user between validate and kill (TOCTOU).
        # We must not kill it — just clean up our stale pidfile.
        try:
            os.unlink(pidfile_path)
        except FileNotFoundError:
            pass
        return True

    # Poll until dead (up to 3s)
    for _ in range(30):
        # Best-effort zombie reap — if this PID is our child process,
        # it may be a zombie after SIGTERM. Reaping makes os.kill(pid, 0)
        # correctly report it as dead. No-op for non-children.
        # NOTE: The spec says "os.waitpid() is NOT used" for the
        # "different invocation" case, but stop_component is also called
        # during same-invocation rollback (e.g., start_command_impl).
        # Without waitpid, zombie children appear alive to os.kill(pid, 0),
        # causing false SIGKILL escalation. The broad exception handling
        # makes this a safe no-op when the process is not our child.
        try:
            os.waitpid(pid, os.WNOHANG)
        except (ChildProcessError, ProcessLookupError, PermissionError, OSError):
            pass
        try:
            os.kill(pid, 0)
            time.sleep(0.1)
        except (ProcessLookupError, PermissionError):
            # ProcessLookupError: dead. PermissionError: PID reused by
            # another user during polling — treat as "not ours anymore".
            break
    else:
        # Still alive after 3s — revalidate identity before SIGKILL to
        # protect against PID reuse during the grace period.
        recheck = validate_pid_tristate(pid, created_epoch, expected_comm)
        if recheck != "alive":
            # Process died or PID was reused — do not send SIGKILL.
            if recheck == "dead":
                try:
                    os.unlink(pidfile_path)
                except FileNotFoundError:
                    pass
            # "unknown" → preserve pidfile (fail closed)
            return True

        try:
            os.kill(pid, signal.SIGKILL)
            time.sleep(0.1)
        except (ProcessLookupError, PermissionError):
            pass
        # Best-effort zombie reap after SIGKILL
        try:
            os.waitpid(pid, os.WNOHANG)
        except (ChildProcessError, ProcessLookupError, PermissionError, OSError):
            pass
        # Verify process is actually dead
        try:
            os.kill(pid, 0)
            # Still alive after SIGKILL — log warning and return False
            print(f"Warning: PID {pid} ({expected_comm}) survived SIGKILL", file=sys.stderr)
            return False
        except (ProcessLookupError, PermissionError):
            pass  # Dead or reused by another user — proceed to cleanup

    # Clean up pidfile
    try:
        os.unlink(pidfile_path)
    except FileNotFoundError:
        pass
    return True


# ---------------------------------------------------------------------------
# Tier reconciliation
# ---------------------------------------------------------------------------

TIER_COMPONENTS: dict[str, list[str]] = {
    "headless": ["xvfb"],
    "xpra": ["xpra"],
    "vnc": ["x11vnc", "websockify"],
}

# Stop order: viewers first, then display
STOP_ORDER: list[str] = ["websockify", "x11vnc", "xpra", "xvfb"]


def compute_tier_diff(
    old_tiers: set[str], new_tiers: set[str]
) -> tuple[set[str], set[str]]:
    """Compute which tiers to stop and start for a declarative start.

    Returns (to_stop, to_start).
    """
    return old_tiers - new_tiers, new_tiers - old_tiers


def compute_cascade_stop(tier: str, current: set[str]) -> set[str]:
    """Compute which tiers to stop. Headless cascades everything."""
    if tier == "headless" or tier == "all":
        return set(current)
    return {tier} & current


def tier_components(tier: str) -> list[str]:
    """Map a tier name to its component process names."""
    return TIER_COMPONENTS.get(tier, [])


# ---------------------------------------------------------------------------
# Tiers file I/O
# ---------------------------------------------------------------------------

def write_tiers(path: str, tiers: set[str]) -> None:
    """Atomically write the active tiers set. Rejects symlinks.

    Validates that all tier names are component-level tiers (not meta-tiers
    like "all") to keep the read/write contract symmetric.
    """
    unknown = tiers - _COMPONENT_TIERS
    if unknown:
        raise ValueError(f"Cannot persist non-component tier names: {unknown}")
    if os.path.lexists(path) and os.path.islink(path):
        raise OSError(f"Refusing to write tiers file over symlink: {path}")

    dir_path = os.path.dirname(path) or "."
    fd = tempfile.mkstemp(dir=dir_path, prefix=".tiers-")
    try:
        os.write(fd[0], " ".join(sorted(tiers)).encode() + b"\n")
        os.close(fd[0])
        if os.path.lexists(path) and os.path.islink(path):
            os.unlink(fd[1])
            raise OSError(f"Refusing to write tiers file over symlink: {path}")
        os.rename(fd[1], path)
    except BaseException:
        try:
            os.unlink(fd[1])
        except FileNotFoundError:
            pass
        raise


def read_tiers(path: str) -> Optional[set[str]]:
    """Read the active tiers from file. Returns None if missing.

    Rejects symlinks and non-regular files (FIFOs) to prevent DoS.
    """
    if os.path.islink(path):
        return None
    try:
        fd = _safe_open_regular(path, os.O_RDONLY)
        try:
            data = os.read(fd, 256).decode().strip()
        finally:
            os.close(fd)
        if not data:
            return None
        # Validate tier names — reject unknown values from tampered files
        # Uses _COMPONENT_TIERS (not _TIER_DEPS.keys()) to exclude "all" meta-tier
        tiers = set(data.split())
        unknown = tiers - _COMPONENT_TIERS
        if unknown:
            return None  # Treat corrupted tiers file as missing
        return tiers
    except (FileNotFoundError, OSError, UnicodeDecodeError):
        return None


def delete_tiers(path: str) -> None:
    """Delete the tiers file. Safe if missing."""
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass


# ---------------------------------------------------------------------------
# Locking
# ---------------------------------------------------------------------------

def acquire_lock(
    path: str, *, exclusive: bool = True, timeout: float = 30.0
) -> Optional[int]:
    """Acquire a file lock. Returns fd on success, None on timeout.

    Opens with O_NOFOLLOW | O_NONBLOCK and verifies the fd is a regular
    file via fstat to prevent FIFO-based DoS and symlink attacks.
    """
    try:
        fd = os.open(
            path,
            os.O_CREAT | os.O_WRONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
            0o644,
        )
    except OSError:
        return None

    # Verify this is a regular file (reject FIFOs, devices, etc.)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            os.close(fd)
            return None
    except OSError:
        os.close(fd)
        return None

    lock_type = fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH
    deadline = time.monotonic() + timeout
    interval = 0.1

    while True:
        try:
            fcntl.flock(fd, lock_type | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.monotonic() >= deadline:
                os.close(fd)
                return None
            time.sleep(interval)


def release_lock(fd: int) -> None:
    """Release a file lock."""
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)
    except OSError:
        pass


# ---------------------------------------------------------------------------
# Preflight
# ---------------------------------------------------------------------------

def find_binary(name: str) -> Optional[str]:
    """Find a binary on PATH. Returns full path or None."""
    return shutil.which(name)


def check_binaries(names: list[str]) -> list[str]:
    """Return list of missing binaries from the given names."""
    return [n for n in names if find_binary(n) is None]


# ---------------------------------------------------------------------------
# Port detection
# ---------------------------------------------------------------------------

def check_port_available(host: str, port: int) -> bool:
    """Check if a TCP port is available by attempting to bind."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 0)
    try:
        sock.bind((host, port))
        return True
    except OSError:
        return False
    finally:
        sock.close()


def identify_port_user(port: int) -> Optional[str]:
    """Use sockstat to identify what process is using a port.

    Uses absolute path /usr/bin/sockstat to prevent PATH hijacking.
    """
    try:
        result = subprocess.run(
            ["/usr/bin/sockstat", "-l", "-p", str(port)],
            capture_output=True, text=True, timeout=5,
        )
        lines = result.stdout.strip().split("\n")
        if len(lines) > 1:
            return lines[1]  # first data line after header
        return None
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None


# ---------------------------------------------------------------------------
# Env output
# ---------------------------------------------------------------------------

def format_env(cfg: Config) -> str:
    """Format DISPLAY and XAUTHORITY as shell export lines.

    Uses shlex.quote() to prevent shell injection if values contain
    metacharacters (defense in depth — xauth regex already blocks them).
    """
    return (
        f"export DISPLAY={shlex.quote(cfg.display)}\n"
        f"export XAUTHORITY={shlex.quote(cfg.xauth)}\n"
    )


# ---------------------------------------------------------------------------
# Log rotation
# ---------------------------------------------------------------------------

def rotate_log(path: str) -> None:
    """Rotate log file: current -> .prev. Safe if missing."""
    try:
        os.rename(path, path + ".prev")
    except FileNotFoundError:
        pass


# ---------------------------------------------------------------------------
# Xauth
# ---------------------------------------------------------------------------

def create_xauth_file(path: str) -> None:
    """Create an xauth file with mode 0600. Rejects symlinks.

    Uses O_CREAT|O_EXCL|O_NOFOLLOW to atomically create the file. If the
    file already exists, verifies it is a regular file (not a symlink) and
    removes it before retrying. The retry loop closes the TOCTOU gap between
    unlink and O_EXCL open.
    """
    for attempt in range(3):
        try:
            fd = os.open(
                path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600
            )
            os.close(fd)
            return
        except FileExistsError:
            # File exists — check if it is a symlink (attack) or regular file
            if os.path.islink(path):
                raise OSError(f"Refusing to create xauth over symlink: {path}")
            # Regular file — remove and retry
            try:
                os.unlink(path)
            except FileNotFoundError:
                pass  # Raced with another remover — retry will succeed
        except OSError as exc:
            # O_NOFOLLOW on a symlink raises ELOOP/ENOENT on some systems
            if os.path.islink(path):
                raise OSError(f"Refusing to create xauth over symlink: {path}") from exc
            raise
    raise OSError(f"Failed to create xauth file after 3 attempts: {path}")


# ---------------------------------------------------------------------------
# Readiness probes
# ---------------------------------------------------------------------------

def wait_ready(
    check: Callable[[], bool], *, retries: int = 10, delay: float = 0.5
) -> bool:
    """Poll a readiness check function. Returns True if check passes."""
    for _ in range(retries):
        if check():
            return True
        time.sleep(delay)
    return False


# ---------------------------------------------------------------------------
# Subcommands (stubs — implemented in later tasks)
# ---------------------------------------------------------------------------

def main() -> None:
    """Entry point."""
    args = parse_args(sys.argv[1:])
    if args.command is None:
        parse_args(["--help"])  # prints help and calls sys.exit(0)
    print(f"x11ctl: command '{args.command}' not yet implemented", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
